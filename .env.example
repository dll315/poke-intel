HOST=127.0.0.1
PORT=3001
ORIGIN=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DB_PATH=data/poke.db
TRUST_PROXY=0
VITE_ICP_NUMBER=
# 企业微信机器人：留空禁用。填写完整官方 Webhook 地址，仅服务端读取。
WECOM_WEBHOOK_URL=
# 管理后台保存机器人配置所需的 32 字节密钥。生成后请固定保存，不能随意更换。
SETTINGS_ENCRYPTION_KEY=
# Alphapedia 资料库同步：确认你有权复用数据后，将两项都设为 1。
ALPHAPEDIA_ENABLED=0
ALPHAPEDIA_PERMISSION_CONFIRMED=0
ALPHA_MONITOR_ENABLED=0
ALPHA_MONITOR_INTERVAL_SECONDS=30
# 生产部署请改为 NODE_ENV=production、HOST=0.0.0.0 和自己的 HTTPS 域名。
# 用户报告邮箱用作登录标识；当前不发送验证邮件。
